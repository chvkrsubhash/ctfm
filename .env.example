# ============================================================
# CTF Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME="CTF Platform"
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database (MongoDB) ───────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ctf_platform

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_64
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=CTF Platform

# ── Storage (AWS S3) ─────────────────────────────────────────
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
AWS_S3_BUCKET=ctf-platform-files
# Optional: custom endpoint for R2 / MinIO
AWS_S3_ENDPOINT_URL=

# For local development (STORAGE_PROVIDER=local):
LOCAL_STORAGE_PATH=./storage_files

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Login: 10 attempts per 15 minutes per IP
LOGIN_RATE_LIMIT=10/15minutes
# Flag submission: 10 per minute per team per challenge
SUBMISSION_RATE_LIMIT=10/minute
# Password reset: 5 per hour per IP
PASSWORD_RESET_RATE_LIMIT=5/hour

# ── Security ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# Session cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── First Superadmin (seeded on first run) ───────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── PostgreSQL (Docker Compose) ──────────────────────────────
POSTGRES_USER=ctf_user
POSTGRES_PASSWORD=ctf_password
POSTGRES_DB=ctf_platform
